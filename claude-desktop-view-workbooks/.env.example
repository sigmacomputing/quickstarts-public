# Claude Desktop: View Workbooks

# .env configuration file. Copy this file to .env and fill in your values.
# Never commit .env.

###############################################################
# Shared settings
###############################################################

# Lifetime of each signed JWT in seconds. Each JWT works only once.
SESSION_LENGTH=3600

# Client credentials (Administration > Developer Access) with both Embedding and
# REST API selected. Embedding signs the JWT that opens each workbook, and REST API
# lets the server list workbooks to search.
CLIENT_ID=
SECRET=

#########################################################
# Default Embed User
# Each workbook opens as this Sigma user. Use your own Sigma email
# to see exactly what you can see in Sigma.
#########################################################

EMAIL=

###############################################
# Claude Desktop: View Workbooks
###############################################

# Any workbook URL in your organization. The app host and organization
# are read from it, and it opens when no workbook is named.
CLAUDE_DESKTOP_BASE_URL=

# The Sigma API host. This depends on where your organization is hosted.
# Your Base URL is shown in Administration > Developer Access. For example,
# AWS-US (East) uses https://api.us-a.aws.sigmacomputing.com
CLAUDE_DESKTOP_API_URL=https://aws-api.sigmacomputing.com

# eof
