# Claude Desktop: View Workbooks

# .env configuration file. Copy this file to .env and fill in your values.
# Never commit .env.

###############################################################################
# Environment Configuration Notes:
#
# - CLIENT_ID, SECRET, and SESSION_LENGTH are shared settings.
# - The default embed user (EMAIL, ACCOUNT_TYPE, TEAMS) is used unless the
#   CLAUDE_DESKTOP_ version of the setting is provided.
# - Settings that start with CLAUDE_DESKTOP_ apply only to this project and
#   override the defaults.
###############################################################################

###############################################################
# Shared settings
###############################################################

# Lifetime of each signed JWT in seconds (maximum 2592000). Each JWT works only once.
SESSION_LENGTH=3600

# Client credentials (Administration > Developer Access) with both Embedding and
# REST API selected. Used to sign the JWT that opens each workbook and, by default, to search.
CLIENT_ID=
SECRET=

# OPTIONAL EMBED PARAMETERS (defaults are shown)
disable_auto_refresh=false
disable_mobile_view=false
hide_folder_navigation=false
hide_menu=false
hide_page_controls=false
hide_reload_button=false
hide_title=false
hide_tooltip=false
hide_view_select=false
lng=English
menu_position=top
page_id=
responsive_height=false
theme=Lite
view_id=

#########################################################
# Default Embed User - MANDATORY
# The workbook view and the search run as this Sigma user.
# Use your own Sigma email to see exactly what you can see in Sigma.
#########################################################

EMAIL=
ACCOUNT_TYPE=View
TEAMS=

###############################################
# Claude Desktop: View Workbooks
###############################################

# Any workbook URL in your organization. The app host and organization
# are read from it, and it opens when no workbook is named.
CLAUDE_DESKTOP_BASE_URL=

# The Sigma API host. This depends on where your organization is hosted.
CLAUDE_DESKTOP_API_URL=https://aws-api.sigmacomputing.com

# Optional overrides of the default embed user
# CLAUDE_DESKTOP_EMAIL=
# CLAUDE_DESKTOP_ACCOUNT_TYPE=
# CLAUDE_DESKTOP_TEAMS=

# Optional user attributes added to the JWT, for example for row-level security
# CLAUDE_DESKTOP_ua_Store_Region=

# Only search workbooks whose path starts with this value, for example a dedicated workspace
# CLAUDE_DESKTOP_SEARCH_PATH_PREFIX=

# Search runs as the embed user by default (user). Set to client to search with
# API client credentials instead, which list whatever that client can see.
# CLAUDE_DESKTOP_SEARCH_AUTH=user
# CLAUDE_DESKTOP_API_CLIENT_ID=
# CLAUDE_DESKTOP_API_CLIENT_SECRET=

# Writes diagnostics to stderr. Never to stdout, which carries the MCP protocol.
# DEBUG=true

# eof
