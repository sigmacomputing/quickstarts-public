# Sigma API host for your cloud, for example https://api.us-a.aws.sigmacomputing.com
SIGMA_BASE_URL=
CLIENT_ID=
SECRET=

# Paste the ID from the end of the browser URL of the element library workbook
# (the text after the last hyphen, for example n31S7AbQwMsxpOY93hRom)
LIBRARY_WORKBOOK_ID=

# Paste the ID from the end of the browser URL of the folder where the generated workbook is created
TARGET_FOLDER_ID=

PORT=3000

# Embed settings for the embedded view
ORG_SLUG=
EMBED_EMAIL=
EMBED_ACCOUNT_TYPE=View
EMBED_TEAMS=
