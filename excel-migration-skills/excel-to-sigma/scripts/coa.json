{
  "_comment": "Canonical chart-of-accounts for a broker equity-research template (FactSet-style house model). Maps a file's line-item labels to stable canonical accounts so a fleet of ~850 'similar but not identical' files can be reconciled. Curated from a reference model; grow `aliases` from batch-convert.py's 'top unmapped labels' rollup. such desks are often bilingual, so aliases carry EN + FR. `shape` is the expected canonical formula (advisory: a per-file formula that disagrees is a flag, not an auto-reject). Segments/geographies are a DYNAMIC dimension (not in the COA) - carried as data.",
  "template": {
    "name": "broker-factset-equity-research",
    "sheets_expected": [
      "FY results",
      "Quarterly",
      "Annuals",
      "Interims",
      "P&L Annual",
      "P&L Quarters",
      "Income Statement"
    ],
    "annual_sheet_names": [
      "FY results",
      "Annuals",
      "P&L Annual",
      "Income Statement",
      "P&L",
      "Financials",
      "Model"
    ],
    "_annual_sheet_names_note": "The annual-statement sheet is named variously across the fleet (grow this list from failures). batch-convert.py prefers a name match before content auto-detection; a rollup sheet (mostly cross-sheet links) is redirected to its source by infer.resolve_rollup.",
    "sections_expected": [
      "PROFIT AND LOSS",
      "PER SHARE DATA",
      "EVALUATION",
      "BALANCE SHEET",
      "CHANGE IN NET DEBT",
      "COMPUTED ASSUMPTIONS",
      "INCOME STATEMENT",
      "CASH FLOW STATEMENT",
      "CASH FLOW",
      "EQUITY"
    ],
    "fdscache_marker": "__FDSCACHE__",
    "fingerprint_weights": {
      "sections": 0.2,
      "sheets": 0.1,
      "label_jaccard": 0.2,
      "formula_shapes": 0.2,
      "anchors": 0.3
    },
    "_fingerprint_note": "anchors = fraction of {revenue, profit, bottom-line, EPS} categories resolved \u2014 the most template-agnostic 'this is a financial statement' signal, robust to section/sheet-name variation.",
    "thresholds": {
      "same": 0.75,
      "variant": 0.45
    }
  },
